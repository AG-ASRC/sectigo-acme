ServerUrl=
Domain=*.domain.tld | example.tld
DomainOnly=example.tld
AcmeScriptPath=/opt/SectigoSSL/acme-hook.sh
CertificatsPath=/certs
WorkerUrl=
MaxDays=10
CoolDownBeforeCheckChallenge=120
WebServer=apache2
CerbotPath=/opt/SectigoSSL/certbot.sh
CrontabPath=/opt/SectigoSSL/crontab.sh
LogsPath=/var/log/SectigoSSL